[CustomMessages]
; Application specific
AppDescription=Conversor de imágenes sencillo

; Setup process messages
LaunchingSetup=Iniciando la instalación de {#MyAppName} {#MyAppVersion}...

; Uninstall messages
RemoveUserData=¿Quiere eliminar todos los datos de usuario y la configuración?
UninstallConfirmation=¿Seguro que quiere desinstalar {#MyAppName} {#MyAppVersion} y todos sus componentes?
ConfirmUninstall=¿Seguro que quiere desinstalar %1 y todos sus componentes?
